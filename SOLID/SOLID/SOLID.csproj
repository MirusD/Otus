<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Sounds\dendy-chocolate.mp3" />
    <None Remove="Resources\Sounds\dendy-game_over.mp3" />
    <None Remove="Resources\Sounds\dendy-laxity.mp3" />
    <None Remove="Resources\Sounds\dendy-win.mp3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

	<ItemGroup>
		<Content Include="Resources\Sounds\dendy-chocolate.mp3">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Sounds\dendy-game_over.mp3">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Sounds\dendy-laxity.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Sounds\dendy-win.mp3">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
